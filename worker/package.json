{
  "name": "karpservice-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/auth.js && node --check src/index.js",
    "test": "node --test test/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply karpservice-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply karpservice-auth --remote"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
