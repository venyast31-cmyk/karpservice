{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karpservice-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {
    "APPLE_ONLY_AUTH": "true",
    "ACCOUNT_DELETION_DAYS": "7",
    "ROAPP_BRANCH_ID": "136446",
    "ALLOWED_ORIGINS": "https://karpservice-app.pages.dev,https://venyast31-cmyk.github.io",
    "TELEGRAM_WEBHOOK_ORIGIN": "https://karpservice-api.venyast31.workers.dev",
    "ANALYTICS_ADMIN_TOKEN_SHA256": "328928874863168280a1a1e539fb75f4950069a8261cf501b125d839e91c91f5"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "karpservice-auth",
      "database_id": "e7568dec-237a-4f1d-b8eb-fd1170af09e9",
      "migrations_dir": "migrations"
    }
  ]
}
